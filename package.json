{
  "name": "scrollframes",
  "version": "0.1.0",
  "description": "Scroll-scrubbed image sequences (\"video on scroll\") on a canvas. Framework-agnostic core with React and Vue components, plus a Python converter from video to frames.",
  "keywords": [
    "scroll",
    "scrollytelling",
    "image-sequence",
    "video",
    "canvas",
    "scroll-animation",
    "react",
    "vue"
  ],
  "license": "MIT",
  "author": "Jose Alfonso Guerrero Juarez <ajuarez93> (https://www.ajuarez93.com)",
  "homepage": "https://github.com/ajuarez93/scrollframes#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ajuarez93/scrollframes.git"
  },
  "bugs": "https://github.com/ajuarez93/scrollframes/issues",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./vue": {
      "import": {
        "types": "./dist/vue.d.ts",
        "default": "./dist/vue.js"
      },
      "require": {
        "types": "./dist/vue.d.cts",
        "default": "./dist/vue.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "converter/scrollframes_convert.py",
    "converter/requirements.txt"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "demo": "vite demo",
    "demo:build": "vite build demo",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "peerDependencies": {
    "react": ">=17",
    "vue": ">=3.2"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vue": "^3.5.13"
  }
}
